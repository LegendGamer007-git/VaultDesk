rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /_connection_test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isOwner(userId) || request.auth.token.email_verified == true);
      allow delete: if false;
    }

    // Errors Collection
    match /errors/{errorId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Knowledge Base Articles
    match /kb_articles/{articleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Security Advisories Collection
    match /advisories/{advisoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // PSM Connectors Collection
    match /connectors/{connectorId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Bookmarks Collection
    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
